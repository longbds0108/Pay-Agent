# Xem docs/SETUP.md để biết cách lấy từng giá trị bên dưới, từ đầu.

# --- Supabase (Auth + Postgres) ---
# Tạo project tại https://supabase.com/dashboard, lấy 3 giá trị này ở
# Project Settings > API. Sau đó chạy các file trong supabase/migrations/
# bằng Supabase SQL editor hoặc `supabase db push`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Arc chain (testnet) ---
# Giá trị mặc định đã đúng theo docs.arc.io, chỉ cần đổi nếu bạn dùng RPC
# provider khác (Blockdaemon/dRPC/QuickNode/Alchemy) hoặc chuyển mainnet sau này.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042002

# --- Circle Developer-Controlled Wallets (Agent Wallet cho user login Google) ---
# Đăng ký tại https://console.circle.com (chọn môi trường Sandbox/Testnet).
# CIRCLE_API_KEY: Web3 Services > API Keys.
# CIRCLE_ENTITY_SECRET + CIRCLE_WALLET_SET_ID: chạy `npm run circle:setup`
# (script trong scripts/circle-setup.ts) sau khi có CIRCLE_API_KEY — script sẽ
# tự tạo entity secret, đăng ký với Circle, tạo 1 wallet set, và in ra 2 giá
# trị này để bạn dán vào đây.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# --- AI model cho agent (DeepSeek, tương thích OpenAI chat completions) ---
# Lấy API key tại https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- x402 nanopayments (Circle Gateway) ---
# URL public của app (dùng để agent tự gọi lại endpoint x402 của chính nó).
# Khi deploy thật, đổi thành domain thật.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Địa chỉ ví nhận tiền cho endpoint x402 demo (/api/x402/weather). Để trống sẽ
# dùng placeholder demo — thay bằng ví thật nếu muốn xem tiền thực sự đến nơi.
X402_SELLER_ADDRESS=
